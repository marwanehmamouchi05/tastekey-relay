# Copy to apps/web/.env.local, or use the harness private config: pnpm qloo -- setup --qloo
QLOO_API_KEY=
# Event-issued credential endpoint (from the organizer's access email).
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Persistent disk path. Container default is /app/data/tastekey.db
TASTEKEY_DB_PATH=
# Optional OpenAI-compatible model provider. Use a provider with a free tier.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_PROVIDER=
MODEL_REGION=eu-west-3
# Bedrock: use a dedicated model-scoped IAM identity, never your development credentials.
MODEL_AWS_ACCESS_KEY_ID=
MODEL_AWS_SECRET_ACCESS_KEY=
MODEL_AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
# Persisted global daily request cap; each output is also token-limited.
MODEL_CALLS_PER_DAY=40
MODEL_ACCESS_EXPIRES=
# Configure server URL for origin validation behind a reverse proxy
APP_ORIGIN=http://localhost:3000
# Identity provider: server-side OpenID Connect, authorization code + PKCE.
# Use a verified-email provider, e.g. a dedicated AWS Cognito user pool.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Optional for confidential clients; never use NEXT_PUBLIC_ for identity secrets.
OIDC_CLIENT_SECRET=
# Optional HTTPS provider logout endpoint, including registered client/return URL.
OIDC_LOGOUT_URL=
